# Plantilla de las variables de la infraestructura.
#
# No se edita a mano: scripts/generar-secretos.sh copia este archivo a .env
# rellenando con una clave aleatoria toda variable que aqui quede vacia.
# El .env no se sube a git.

COMPOSE_PROJECT_NAME=pac-invoicing-v2

# --- MongoDB -----------------------------------------------------------
# root administra; "core" escribe en la base invoicing; "ride" solo lee.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_CORE_PASSWORD=
MONGO_RIDE_PASSWORD=

# --- Postgres ----------------------------------------------------------
# Dos bases con dueno distinto: "config" y "signer".
POSTGRES_PASSWORD=
PG_CONFIG_PASSWORD=
PG_SIGNER_PASSWORD=
